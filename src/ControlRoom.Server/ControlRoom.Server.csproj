<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ControlRoom.Server</RootNamespace>
    <!-- The version is only the passed -p:Version, never with a +sha suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- A build without -p:Version reports "dev" (AppVersion reads the informational version). -->
  <PropertyGroup Condition="'$(Version)' == ''">
    <InformationalVersion>dev</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ControlRoom.Server.Tests" />
  </ItemGroup>

</Project>
