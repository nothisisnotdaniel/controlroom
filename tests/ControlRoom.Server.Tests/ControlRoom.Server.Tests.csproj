<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The same pin as ControlRoom.Server.csproj, so the tests can read the package folder ($(PkgRoomKit)). -->
    <PackageReference Include="RoomKit" Version="0.3.0" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- The restored RoomKit package folder, read by RoomKitPackage.Folder(). -->
  <ItemGroup>
    <AssemblyMetadata Include="RoomKitPackage" Value="$(PkgRoomKit)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="RoomKit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ControlRoom.Server\ControlRoom.Server.csproj" />
  </ItemGroup>

</Project>
